# ---------- Server (server/.env) ----------
# MongoDB connection string WITHOUT a database name (the app appends "/lms").
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=

# Clerk -> https://dashboard.clerk.com -> API Keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk -> Webhooks (OPTIONAL for local use; users are also created in MongoDB on first login)
CLERK_WEBHOOK_SECRET=

# Optional
PORT=5000
# Public URL of this server, used to build thumbnail URLs (defaults to the request host)
SERVER_URL=
